datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  INSTRUCTOR
  MODERATOR
  EDITOR
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  TIMEOUT
  ERROR
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  avatar       String?
  role         UserRole  @default(USER)
  isVerified   Boolean   @default(false)
  xp           Int       @default(0)
  level        Int       @default(1)
  streak       Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  lessonProgress   LessonProgress[]
  submissions      Submission[]
  userAchievements UserAchievement[]
  certificates     Certificate[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Course {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  title            String
  description      String        @db.Text
  shortDescription String        @db.VarChar(500)
  coverImage       String?
  level            CourseLevel   @default(BEGINNER)
  status           PublishStatus @default(DRAFT)
  estimatedHours   Int           @default(10)
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  modules      CourseModule[]
  certificates Certificate[]
  roadmapSteps RoadmapStep[]

  @@index([slug])
  @@index([status])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  moduleId         String        @db.Uuid
  slug             String        @unique
  title            String
  description      String?       @db.Text
  content          String        @db.Text
  order            Int           @default(0)
  estimatedMinutes Int           @default(15)
  status           PublishStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  module        CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  practiceTasks PracticeTask[]

  @@index([slug])
  @@index([moduleId])
  @@map("lessons")
}

model LessonProgress {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  lessonId        String         @db.Uuid
  status          ProgressStatus @default(NOT_STARTED)
  progressPercent Int            @default(0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model PracticeTask {
  id          String         @id @default(uuid()) @db.Uuid
  lessonId    String         @db.Uuid
  title       String
  description String         @db.Text
  difficulty  TaskDifficulty @default(EASY)
  starterCode String         @db.Text
  solution    String?        @db.Text
  language    String         @default("javascript")
  points      Int            @default(20)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  submissions Submission[]

  @@index([lessonId])
  @@map("practice_tasks")
}

model TestCase {
  id             String  @id @default(uuid()) @db.Uuid
  taskId         String  @db.Uuid
  input          String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean @default(false)

  task PracticeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("test_cases")
}

model Submission {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  taskId        String           @db.Uuid
  code          String           @db.Text
  language      String           @default("javascript")
  status        SubmissionStatus @default(PENDING)
  score         Int              @default(0)
  executionTime Int?
  errorMessage  String?          @db.Text
  createdAt     DateTime         @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task PracticeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@map("submissions")
}

model Roadmap {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String   @db.Text
  level       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps RoadmapStep[]

  @@index([slug])
  @@map("roadmaps")
}

model RoadmapStep {
  id          String   @id @default(uuid()) @db.Uuid
  roadmapId   String   @db.Uuid
  title       String
  description String   @db.Text
  order       Int      @default(0)
  courseId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([roadmapId])
  @@map("roadmap_steps")
}

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String   @db.Text
  icon        String
  xpReward    Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]

  @@index([slug])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String   @db.Uuid
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  courseId          String   @db.Uuid
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([certificateNumber])
  @@map("certificates")
}

// ============================================================================
// GLOBAL KNOWLEDGE UNIVERSE MODELS
// ============================================================================

model KnowledgeCategory {
  id          String          @id @default(uuid()) @db.Uuid
  technology  String          // "html", "css", "javascript", "svg", "xml", "markdown", "canvas"
  slug        String
  name        String
  description String?         @db.Text
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  nodes       KnowledgeNode[]

  @@unique([technology, slug])
  @@index([technology])
  @@map("knowledge_categories")
}

model KnowledgeNode {
  id                String            @id @default(uuid()) @db.Uuid
  categoryId        String            @db.Uuid
  technology        String            // "html", "css", "javascript", "svg", "xml", "markdown", "canvas"
  nodeType          String            // "element", "attribute", "concept", "api", "rule", "historical"
  name              String            // e.g. "article", "href", "Tokenization"
  slug              String            // e.g. "article", "href"
  englishName       String?
  status            String            @default("CURRENT") // "CURRENT", "DEPRECATED", "OBSOLETE", "EXPERIMENTAL"
  introducedIn      String?           // e.g. "HTML5", "HTML 2.0"
  deprecatedIn      String?
  replacedBy        String?
  syntax            String?           @db.Text
  kidExplanation    String?           @db.Text
  kidAnalogy        String?           @db.Text
  technicalSummary  String            @db.Text
  detailedContent   String            @db.Text
  codeExample       String?           @db.Text
  expectedOutput    String?           @db.Text
  commonMistakes    String?           @db.Text
  browserSupport    Json?
  accessibility     String?           @db.Text
  security          String?           @db.Text
  specUrl           String?
  specName          String?
  aliases           String[]          @default([])
  relatedNodes      String[]          @default([])
  order             Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  category          KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([technology, slug])
  @@index([technology, nodeType])
  @@index([slug])
  @@index([name])
  @@map("knowledge_nodes")
}
