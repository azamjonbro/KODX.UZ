{
  "name": "kodx-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "KODX 2.0 — Modern Interactive Programming Education Platform for Uzbek Developers",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@kodx/*\" dev",
    "dev:web": "pnpm --filter @kodx/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
