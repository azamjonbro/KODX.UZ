# ==========================================
# KODX 2.0 — Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development

# Core API Settings (Using port 4005 to prevent local port collisions)
PORT=4005
API_URL=http://localhost:4005
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175

# Vite Frontend API Endpoint
VITE_API_URL=http://localhost:4005/api/v1

# Database (PostgreSQL container mapped to port 5434)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/kodx_db?schema=public"

# Redis container mapped to port 6382
REDIS_URL="redis://localhost:6382"

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_long_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_long_67890
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug
